<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WinQuad</AssemblyName>
    <RootNamespace>WinQuad</RootNamespace>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 显式声明 asInvoker：覆盖层要 SetParent 挂到 explorer 的桌面窗口上，
         提权会被 UIPI 拦掉。不写清单时 SDK 默认也是 asInvoker，但那是"默认行为"，
         写死在这里更明确。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- 图标源文件是 assets\icon.svg，用 assets\render-icon.ps1 + make-ico.ps1 生成 -->
    <ApplicationIcon>..\assets\icon.ico</ApplicationIcon>

    <!-- v0.2：每个宫格可单独设占地与形状、自动等比、文字投影、右键快捷方式操作 -->
    <Version>0.2.0</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <Product>WinQuad —— Windows 桌面四宫格</Product>
    <Description>把桌面快捷方式收进 2×2 的小格子，每个格子只占一个图标的位置。</Description>
    <Company>Frozen1096</Company>
    <Copyright>Copyright (C) 2026 Frozen1096</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
  </PropertyGroup>

</Project>
